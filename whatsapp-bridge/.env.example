# Same Postgres database used by web/. On Render with Supabase, use the *Session pooler*
# URL (aws-0-<region>.pooler.supabase.com:5432). The direct db.<ref>.supabase.co host is
# IPv6-only and Render cannot reach it (connect ENETUNREACH).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
WHATSAPP_SESSION_ID="chat-reader"
# Every chat is read. Comma-separated JIDs listed here are skipped completely,
# e.g. a noisy group ("1203630...@g.us") or a contact ("234801...@s.whatsapp.net").
WHATSAPP_IGNORED_CHATS=""
# Days to keep messages. 0 keeps them forever.
WHATSAPP_MESSAGE_RETENTION_DAYS=0
# Linking normally brings in recent history. Set true BEFORE scanning the QR code
# to ask for everything; a long-used account can take a lot of time and database space.
WHATSAPP_SYNC_FULL_HISTORY=false
# Restart the service when WhatsApp has remained disconnected this long.
WHATSAPP_MAX_DISCONNECTED_SECONDS=120
# Must survive restarts; otherwise a QR scan is needed after every deploy.
WHATSAPP_AUTH_DIR=".wwebjs_auth"
# Emergency one-time repair only: set true, deploy, scan the new QR code, then
# set it back to false. This clears just the bridge's persisted auth state.
WHATSAPP_RESET_AUTH_ON_START=false